# =============================================================================
# .env.example — variables de entorno del prototipo
# =============================================================================
# Copia este archivo a .env antes de ejecutar el prototipo:
#   cp .env.example .env
#
# Todos los valores aquí son de USO EXCLUSIVAMENTE LOCAL para fines de
# demostración académica. NO representan prácticas recomendadas de gestión
# de credenciales en un entorno de producción.
# =============================================================================

# Credenciales de MinIO (almacenamiento S3-compatible de artefactos MLflow)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Contraseña de la clave privada cosign generada localmente para el
# prototipo (ver scripts/generate_keys.sh). Puede dejarse vacía
# (COSIGN_PASSWORD=) si se prefiere una clave sin contraseña, pero se
# recomienda fijar un valor para que el comportamiento sea explícito.
#
# NOTA METODOLÓGICA (P-03, sección "Fuerzas"): en un entorno real, esta
# clave privada debe gestionarse mediante un KMS (Key Management Service)
# con políticas de rotación y revocación, no como una variable de entorno
# en texto plano como se hace aquí por simplicidad del prototipo.
COSIGN_PASSWORD=recoshop-prototype-2026

# Nombre bajo el cual se registra el modelo en el MLflow Model Registry
MLFLOW_MODEL_NAME=recoshop-ranker
